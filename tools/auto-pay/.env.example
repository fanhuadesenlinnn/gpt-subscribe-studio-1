# Stripe 商户公开密钥（publishable key，可公开，但建议用环境变量覆盖）
STRIPE_PUBLISHABLE_KEY=pk_live_...

# 测试卡（四张轮换）
CARD_A_NUMBER=<CARD_NUMBER>
CARD_A_EXP_MONTH=01
CARD_A_EXP_YEAR=2030
CARD_A_CVC=000

CARD_B_NUMBER=<CARD_NUMBER>
CARD_B_EXP_MONTH=01
CARD_B_EXP_YEAR=2030
CARD_B_CVC=000

CARD_C_NUMBER=<CARD_NUMBER>
CARD_C_EXP_MONTH=01
CARD_C_EXP_YEAR=2030
CARD_C_CVC=000

CARD_D_NUMBER=<CARD_NUMBER>
CARD_D_EXP_MONTH=01
CARD_D_EXP_YEAR=2030
CARD_D_CVC=000

# hCaptcha solver 服务（推荐）
# 启动方式见 tools/hcaptcha-solver/README.md
HCAPTCHA_SOLVER_URL=http://127.0.0.1:8199

# 共享卷兜底（solver 不在本机时用）
# HCAP_DATA=/data

# 打码服务（可选，第三兜底）
GSS_CAPTCHA_API_KEY=
GSS_CAPTCHA_API_URL=https://api.yescaptcha.com

# 订单代理
ORDER_PROXY=http://user:pass@host:port

# 服务地址
# 改成你自己的部署地址（必填）
GSS_API=http://127.0.0.1:8080
GSS_PUBLIC_ORIGIN=http://127.0.0.1:8080
GSS_SESSION_PASSWORD=

# solver 通过 HTTP 调用即可，无需本机路径
